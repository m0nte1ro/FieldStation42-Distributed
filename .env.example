# copy to .env and adjust; every value has a default
FS42_PORT=4242
# the time zone schedules run in; clients must use the same one
TZ=Europe/Lisbon
# your media library on the host, seen as /media by the server
MEDIA_DIR=./media

# development only (compose.dev.yml): where the dev client draws and plays sound
# WSL (WSLg) defaults:
X11_SOCKET=/tmp/.X11-unix
PULSE_SOCKET=/mnt/wslg/PulseServer
# Linux desktop instead:
# PULSE_SOCKET=/run/user/1000/pulse/native
