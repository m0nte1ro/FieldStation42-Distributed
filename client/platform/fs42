#!/usr/bin/env bash
# fs42 - the Docker client on this PC:
#   fs42 start                    the TV, fullscreen
#   fs42 start --windowed [WxH]   in a window at the screen's top-left corner (default 1280x720)
#   fs42 start --look LOOK        original, broadcast or crt, for this run (else client.json's)
#   fs42 start --osd STYLE        vcr, cable or kids, for this run (else client.json's)
#   fs42 start --resolution N     native, 576 or 480 lines at most, for this run (else client.json's)
#   fs42 setup                    choose the server, look and OSD style, saved in client/client.json
#   fs42 kill                     stop it (the player and its OSD)
#   fs42 logs                     follow the player's log
# Install once, from the repository: ln -s "$PWD/client/platform/fs42" ~/.local/bin/fs42
set -euo pipefail
self="$(readlink -f "$0")"
client="$(cd "$(dirname "$self")/.." && pwd)"
compose=(docker compose -f "$client/compose.yml")
# this machine's own settings (e.g. WSL's GPU), kept out of git
if [ -f "$client/compose.override.yml" ]; then compose+=(-f "$client/compose.override.yml"); fi

case "${1:-}" in
  start)
    FS42_WINDOW="" FS42_LOOK="" FS42_OSD="" FS42_RESOLUTION=""
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --windowed)
          FS42_WINDOW=1280x720
          if [[ "${2:-}" =~ ^[0-9]+x[0-9]+$ ]]; then FS42_WINDOW="$2"; shift; fi
          ;;
        --look) FS42_LOOK="${2:-}"; shift ;;
        --osd) FS42_OSD="${2:-}"; shift ;;
        --resolution) FS42_RESOLUTION="${2:-}"; shift ;;
        *) echo "fs42 start: unknown option $1" >&2; sed -n '2,10p' "$self" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
      esac
      shift
    done
    export FS42_WINDOW FS42_LOOK FS42_OSD FS42_RESOLUTION
    # X11 desktops: let the containers draw (WSLg doesn't need it)
    if command -v xhost >/dev/null && [ -n "${DISPLAY:-}" ]; then xhost +local:docker >/dev/null || true; fi
    "${compose[@]}" up -d
    ;;
  setup) python3 "$client/platform/setup_client.py" "$client/client.json" ;;
  kill) "${compose[@]}" down ;;
  logs) "${compose[@]}" logs -f --since 5m client ;;
  *) sed -n '2,10p' "$self" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
